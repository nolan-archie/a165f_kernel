# Disable Samsung anti-root stuffs
CONFIG_UH=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n
CONFIG_NGKSM=n
CONFIG_KNOX_KAP=n
CONFIG_KNOX_KAP_NGKSM=n
CONFIG_NGKPAD=n
CONFIG_RKP=n
CONFIG_RKP_KDP=n
CONFIG_UH_RKP=n
CONFIG_TIMA=n
CONFIG_TIMA_RKP=n
CONFIG_SAMSUNG_SECURITY=n
CONFIG_FIVE_PA_FEATURE=n

# SukiSU Ultra (KernelSU)
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KSU=y
CONFIG_KSU_DEBUG=y
CONFIG_KPM=y
CONFIG_KSU_MANUAL_HOOK=n

# SUSFS (for KernelSU)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# MTK BT and WLAN DRIVERS
CONFIG_MTK_BT_DRV_EXTERNAL=y
CONFIG_WLAN_DRV_MODULE=y
