diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index 832cf092..78275e37 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -2,6 +2,48 @@
 #define SELINUX_POLICY_INSTEAD_SELINUX_SS
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) && defined(CONFIG_KSU_SUSFS)
+struct selinux_policy *backup_sepolicy;
+
+/*
+ * SUSFS v2.3's SELinux query hooks use an unmodified policy snapshot to hide
+ * KernelSU's injected types and allow rules. Keep this legacy integration for
+ * kernels without SUSFS v2.4's native SELinux type/AV tables.
+ */
+static void ksu_save_backup_sepolicy(struct selinux_policy *policy)
+{
+	struct selinux_policy *backup;
+	int ret;
+
+	if (READ_ONCE(backup_sepolicy))
+		return;
+
+	backup = ksu_dup_sepolicy(policy);
+	if (IS_ERR(backup)) {
+		pr_err("failed to create backup sepolicy: %ld\n", PTR_ERR(backup));
+		return;
+	}
+
+	backup->sidtab = kzalloc(sizeof(*backup->sidtab), GFP_KERNEL);
+	if (!backup->sidtab) {
+		pr_err("failed to allocate backup sidtab\n");
+		ksu_destroy_sepolicy(backup);
+		return;
+	}
+
+	ret = policydb_load_isids(&backup->policydb, backup->sidtab);
+	if (ret) {
+		pr_err("failed to load initial SIDs for backup sepolicy: %d\n", ret);
+		kfree(backup->sidtab);
+		ksu_destroy_sepolicy(backup);
+		return;
+	}
+
+	WRITE_ONCE(backup_sepolicy, backup);
+	pr_info("SUSFS v2.3 backup sepolicy initialized\n");
+}
+#endif
+
 #define ALL NULL
 
 #if ((!defined(KSU_COMPAT_USE_SELINUX_STATE)) || LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0))
@@ -192,6 +234,9 @@ void apply_kernelsu_rules()
 	struct selinux_policy *pol, *old_pol;
 	mutex_lock(&selinux_state.policy_mutex);
 	old_pol = rcu_dereference_protected(selinux_state.policy, lockdep_is_held(&selinux_state.policy_mutex));
+#if defined(CONFIG_KSU_SUSFS)
+	ksu_save_backup_sepolicy(old_pol);
+#endif
 	pol = ksu_dup_sepolicy(old_pol);
 	if (IS_ERR(pol)) {
 		pr_err("failed to dup selinux_policy: %ld\n", PTR_ERR(pol));
